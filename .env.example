# ── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 서버 전용 비밀 키(sb_secret_...). 대화창·GitHub에 올리지 말고 여기와 Vercel 환경변수에만 넣으세요.
SUPABASE_SECRET_KEY=

# ── 카카오맵 (JavaScript 키) ───────────────────────────
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=your_kakao_js_key

# ── 웹 구분 (접속 주소로 관광지/순례 판별) ─────────────
# 쉼표로 여러 개, 포트는 빼고 적습니다. Vercel에서는 배포 주소를 추가하세요.
TOUR_HOSTS=tour.localhost
PILGRIM_HOSTS=pilgrim.localhost
# 위 목록에 없는 주소(Vercel 미리보기 등)로 들어오면 쓸 기본 웹
DEFAULT_SERVICE=tour

# ── 보안 ───────────────────────────────────────────────
# IP를 해시할 때 섞는 임의의 긴 문자열 (아무 값이나 길게)
IP_HASH_SALT=

# ── 최고 관리자 (npm run admin:create 에서만 사용) ──────
SUPER_ADMIN_EMAIL=admin@example.com
# 비워 두면 임시 비밀번호를 만들어 화면에 한 번 보여 줍니다. 대화창에 쓰지 마세요.
SUPER_ADMIN_PASSWORD=
